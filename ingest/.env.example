# Copy to ingest/.env and fill in. Never commit the real file.

# Stage 7 — direct Postgres connection.
# Supabase dashboard: Project Settings > Database > Connection string > URI.
# Use the session pooler (port 5432) for COPY-based bulk loads.
DATABASE_URL=postgresql://postgres.dqbtclsbdcglgurchxrb:YOUR-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Stage 5 — Cloudflare R2 (S3-compatible).
# Dashboard: R2 > Manage R2 API Tokens > Create token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Still `riffle-cards` after two renames, and deliberately so: this is the real
# name of the live bucket holding every card image, not a label. Renaming it
# means copying ~19.5k objects and re-pointing NEXT_PUBLIC_R2_PUBLIC_URL, for no
# user-visible gain — the bucket name never appears in the app.
R2_BUCKET=riffle-cards
# Leave blank to derive from R2_ACCOUNT_ID. A non-empty value wins, so a
# half-filled template here silently aims every upload at a dead host.
R2_ENDPOINT=

# Stage 8 — pokemontcg.io API key (optional; see docs/NOTES.md, TCGdex now
# carries TCGplayer pricing directly, which may make this stage unnecessary).
POKEMONTCG_API_KEY=
